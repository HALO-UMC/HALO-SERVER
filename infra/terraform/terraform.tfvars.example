# terraform.tfvars로 복사해서 사용 (커밋 금지)
tenancy_ocid     = "ocid1.tenancy.oc1..xxxx"
compartment_ocid = "ocid1.tenancy.oc1..xxxx" # 루트 compartment면 tenancy OCID와 같음

ssh_authorized_keys = <<-KEYS
  ssh-ed25519 AAAA... my-pc
  ssh-ed25519 AAAA... github-actions-cd
KEYS

tailscale_auth_key = "tskey-auth-xxxx"

