limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=30r/m;

# 명시적 default_server
server {
    listen 80 default_server;
    server_name _;

    # 부트스트랩 상태에서도 certbot의 HTTP-01 challenge는 이 블록으로 들어옴
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 444;
    }
}