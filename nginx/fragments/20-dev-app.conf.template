server {
    listen 80;
    server_name ${DEV_DOMAIN};

    # Let's Encrypt 인증서 발급/갱신 시 사용하는 challenge 파일 경로
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # server_name이 ${DEV_DOMAIN} 하나로 고정이라 $host 대신 리터럴 도메인으로 리다이렉트
    location / {
        return 301 https://${DEV_DOMAIN}$request_uri;
    }
}

upstream dev_app_upstream {
    server dev-app:8080 max_fails=3 fail_timeout=5s;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DEV_DOMAIN};

    # 인증서는 DOMAIN 발급 시 --expand로 DEV_DOMAIN을 SAN에 포함시켜 공유
    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # 개발 환경은 팀 외 접근 차단
    auth_basic "Restricted";
    auth_basic_user_file /etc/nginx/.htpasswd;

    location /actuator {
        return 404;
    }

    location = /api/v1/auth/login {
        # 브루트포스/트래픽 폭주 방지용 rate limit
        limit_req zone=auth_limit burst=10 nodelay;
        limit_req_status 429;

        proxy_pass http://dev_app_upstream;
        include /etc/nginx/fragments/proxy-common.conf;
    }

    location = /api/v1/auth/reissue {
        # 브루트포스/트래픽 폭주 방지용 rate limit
        limit_req zone=auth_limit burst=10 nodelay;
        limit_req_status 429;

        proxy_pass http://dev_app_upstream;
        include /etc/nginx/fragments/proxy-common.conf;
    }

    location / {
        proxy_pass http://dev_app_upstream;
        include /etc/nginx/fragments/proxy-common.conf;
    }
}